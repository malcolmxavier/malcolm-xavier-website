# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the secret-free template IS committed, so newcomers see which vars exist
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal-only docs and review trackers — kept locally, never tracked
/_private/
# Plan docs (PLAN.md + any PLAN-<feature>.md) stay local working notes.
/PLAN*.md

# Claude Code per-machine permission cache — accumulates per-session approvals
.claude/settings.local.json

# Letterboxd export drop zone — personal viewing data, never committed.
# README.md is exempted so the directory itself stays tracked with
# instructions for whoever clones the repo.
/data/letterboxd-export/*
!/data/letterboxd-export/README.md

# Resume variant overlays. Each one is a small module tailoring the docx to a
# single application, so it is named for a company he is actively pursuing and
# carries his reasoning about how to pitch them. This repo is public, so
# committing one publishes the application. Ignored by directory rather than by
# filename on purpose: the alternative is remembering to rename every future
# variant, and a rule that depends on discipline is the one that leaks. They are
# per-application artifacts anyway, the same category as the tailored .docx the
# script drops in ~/Downloads — scripts/build-resume-docx.mjs runs fine without
# any of them present.
/scripts/resume-variants/
